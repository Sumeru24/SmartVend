# Docker Compose environment for SmartVend.
# Copy this file to .env before running `docker compose up --build`.

# PostgreSQL credentials (used by both the db and backend services).
POSTGRES_USER=smartvend
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=smartvend

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Extra browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=720
SEED_DEMO_DATA=true
